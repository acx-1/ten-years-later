# =============================================
# 十年后 (Ten Years Later) - 环境变量模板
# =============================================
# 复制本文件为 .env 并填入实际值
# .env 文件不应提交到 Git 仓库

# ---------------------------------------------
# 数据库配置 (必填)
# ---------------------------------------------
# MySQL 连接字符串格式:
# mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql://root:password@localhost:3306/ten_years_later

# ---------------------------------------------
# 应用安全配置 (必填)
# ---------------------------------------------
# JWT 签名密钥 (生产环境请使用随机生成的长字符串)
APP_SECRET=your-super-secret-jwt-key-change-this-in-production

# ---------------------------------------------
# 前端应用配置
# ---------------------------------------------
# 应用 ID (用于 OAuth 认证等场景)
VITE_APP_ID=ten-years-later-app

# 认证服务地址 (可选，用于 OAuth 扩展)
VITE_KIMI_AUTH_URL=https://auth.kimi.com

# ---------------------------------------------
# 服务器配置 (可选)
# ---------------------------------------------
# 服务器端口 (默认 3000)
# PORT=3000

# 环境模式 (development / production)
# NODE_ENV=development
